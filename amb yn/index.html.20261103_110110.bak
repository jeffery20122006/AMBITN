        eventName: "National Conference on Advances in Clinical Enzymology & Cancer Metabolism (AMBICON-South 2027)",
        tags: ["AMBICON SOUTH", "CANCER METABOLISM", "PLENARY SESSIONS"],
        workshopNote: "Annual national summit with",
        eventDate: "23rd to 25th April 2027",
        venue: "Madras Medical College, Chennai",
        organizer: "AMBI TN State Chapter",
        eventLink: "https://www.ambitn.org"
      },
      {
        id: "ev-19",
        eventName: "Workshop on Total Quality Management (TQM), Lean Six Sigma & Method Verification in Clinical Labs",
        tags: ["LEAN SIX SIGMA", "TQM", "METHOD VALIDATION"],
        workshopNote: "Process optimization with",
        eventDate: "8th May 2027",
        venue: "Kanyakumari Government Medical College, Asaripallam",
        organizer: "Dept of Biochemistry",
        eventLink: "https://www.ambitn.org"
      },
      {
        id: "ev-20",
        eventName: "Annual AMBI TN Research Colloquium: Oral Paper Presentations & Dr. Ebenezer Gold Medal Award",
        tags: ["RESEARCH PAPERS", "DR. EBENEZER MEDAL", "AWARDS"],
        workshopNote: "State scientific session with",
        eventDate: "21st to 22nd May 2027",
        venue: "Chengalpattu Government Medical College, Chengalpattu",
        organizer: "AMBI TN State Chapter",
        eventLink: "https://www.ambitn.org"
      }
    ];

    let currentEventsDisplayList = [...ambiTNMasterEvents];

    // Helper: Escape HTML strings
    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    // Helper: Build WhatsApp Share URL
    function getWhatsAppShareUrl(event) {
      const title = event.eventName || 'AMBI TN Academic Event';
      const date = event.eventDate || 'Date TBA';
      const venue = event.venue || 'Tamil Nadu';
      const link = event.eventLink || 'https://www.ambitn.org';

      const message = `*AMBI TN Academic Event Announcement*\n\n` +
                      `📌 *${title}*\n` +
                      `📅 *Date:* ${date}\n` +
                      `📍 *Venue:* ${venue}\n\n` +
                      `🔗 *Details & Registration:* ${link}\n\n` +
                      `_Association of Medical Biochemists of India – Tamil Nadu Chapter_`;

      return `https://api.whatsapp.com/send?text=${encodeURIComponent(message)}`;
    }

    // Render table rows
    function renderAmbiEvents(events) {
      const tbody = document.getElementById('wixEventsTableBody');
      tbody.innerHTML = '';

      if (!events || events.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="4" class="table-status-cell">
              <div style="font-size: 26px; margin-bottom: 8px;">📅</div>
              <div style="color: #94a3b8; font-weight: 600;">No matching events found.</div>
              <div style="font-size: 12px; color: #64748b; margin-top: 4px;">Try a different search term or check all events.</div>
            </td>
          </tr>
        `;
        return;
      }

      events.forEach((item, index) => {
        const title = item.eventName || 'Untitled Event';
        const date = item.eventDate || 'Date TBA';
        const venue = item.venue || 'Venue TBA';
        const organizer = item.organizer || '';
        const note = item.workshopNote || 'Workshops on';
        const tags = Array.isArray(item.tags) ? item.tags : [];
        const waUrl = getWhatsAppShareUrl(item);

        const tr = document.createElement('tr');

        // Tags HTML
        let tagsHtml = '';
        if (tags.length > 0) {
          tagsHtml = `
            <div class="event-workshops-tagline">
              <span>${escapeHtml(note)}</span>
              ${tags.map(t => `<span class="badge-highlight">${escapeHtml(t)}</span>`).join('')}
              <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="whatsapp-share-btn" title="Share this event on WhatsApp" onclick="event.stopPropagation();">
                <svg viewBox="0 0 24 24">
                  <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.02L7.55 18.84L4.44 19.66L5.27 16.63L5.07 16.31C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.06 7.42C8.89 7.42 8.62 7.49 8.38 7.74C8.15 8 7.5 8.61 7.5 9.85C7.5 11.09 8.4 12.28 8.53 12.45C8.66 12.62 10.3 15.15 12.8 16.23C13.4 16.48 13.86 16.64 14.23 16.76C14.83 16.95 15.38 16.92 15.81 16.86C16.3 16.79 17.31 16.25 17.52 15.66C17.73 15.07 17.73 14.56 17.67 14.46C17.61 14.36 17.44 14.3 17.18 14.17C16.93 14.04 15.7 13.44 15.47 13.35C15.24 13.27 15.08 13.23 14.91 13.48C14.74 13.73 14.27 14.3 14.13 14.46C13.99 14.63 13.86 14.65 13.6 14.52C13.35 14.4 12.53 14.13 11.56 13.26C10.8 12.58 10.28 11.75 10.15 11.5C10.02 11.25 10.14 11.12 10.26 11C10.38 10.88 10.52 10.7 10.65 10.55C10.78 10.4 10.82 10.29 10.91 10.12C11 9.95 10.95 9.81 10.89 9.68C10.82 9.56 10.31 8.32 10.1 7.81C9.89 7.31 9.68 7.38 9.53 7.37C9.39 7.36 9.22 7.42 9.06 7.42Z"/>
                </svg>
                Share on WhatsApp
              </a>
            </div>
          `;
        }

        tr.innerHTML = `
          <td class="td-sno-col">${index + 1}</td>
          <td>
            <a href="javascript:void(0)" class="event-entry-title" onclick="openWixEventModal(${index})">
              <span>${escapeHtml(title)}</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
            ${tagsHtml}
          </td>
          <td>
            <div class="date-cell-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>${escapeHtml(date)}</span>
            </div>
          </td>
          <td>
            <div class="venue-cell-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <div>
                <div class="venue-name">${escapeHtml(venue)}</div>
                ${organizer ? `<div class="venue-sub">${escapeHtml(organizer)}</div>` : ''}
              </div>
            </div>
          </td>
        `;

        tbody.appendChild(tr);
      });
    }

    // Modal popup handler
    function openWixEventModal(index) {
      const item = currentEventsDisplayList[index];
      if (!item) return;

      const modal = document.getElementById('wixModalBackdrop');
      const titleElem = document.getElementById('wixModalTitle');
      const bodyElem = document.getElementById('wixModalBody');
      const actionsElem = document.getElementById('wixModalActions');

      titleElem.textContent = item.eventName;
      bodyElem.innerHTML = `
        <div class="modal-info-row">
          <strong>📅 Date:</strong> <span>${escapeHtml(item.eventDate)}</span>
        </div>
        <div class="modal-info-row">
          <strong>📍 Venue:</strong> <span>${escapeHtml(item.venue)}</span>
        </div>
        ${item.organizer ? `<div class="modal-info-row"><strong>🏛️ Department:</strong> <span>${escapeHtml(item.organizer)}</span></div>` : ''}
        ${item.tags && item.tags.length ? `
          <div class="modal-info-row" style="margin-top: 14px;">
            <strong>Featured Topics:</strong>
            <div style="margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px;">
              ${item.tags.map(t => `<span class="badge-highlight">${escapeHtml(t)}</span>`).join('')}
            </div>
          </div>
        ` : ''}
      `;

      const waUrl = getWhatsAppShareUrl(item);
      actionsElem.innerHTML = `
        <a href="${waUrl}" target="_blank" rel="noopener noreferrer" class="modal-whatsapp-btn">
          <svg viewBox="0 0 24 24">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.04 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.02L7.55 18.84L4.44 19.66L5.27 16.63L5.07 16.31C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.06 7.42C8.89 7.42 8.62 7.49 8.38 7.74C8.15 8 7.5 8.61 7.5 9.85C7.5 11.09 8.4 12.28 8.53 12.45C8.66 12.62 10.3 15.15 12.8 16.23C13.4 16.48 13.86 16.64 14.23 16.76C14.83 16.95 15.38 16.92 15.81 16.86C16.3 16.79 17.31 16.25 17.52 15.66C17.73 15.07 17.73 14.56 17.67 14.46C17.61 14.36 17.44 14.3 17.18 14.17C16.93 14.04 15.7 13.44 15.47 13.35C15.24 13.27 15.08 13.23 14.91 13.48C14.74 13.73 14.27 14.3 14.13 14.46C13.99 14.63 13.86 14.65 13.6 14.52C13.35 14.4 12.53 14.13 11.56 13.26C10.8 12.58 10.28 11.75 10.15 11.5C10.02 11.25 10.14 11.12 10.26 11C10.38 10.88 10.52 10.7 10.65 10.55C10.78 10.4 10.82 10.29 10.91 10.12C11 9.95 10.95 9.81 10.89 9.68C10.82 9.56 10.31 8.32 10.1 7.81C9.89 7.31 9.68 7.38 9.53 7.37C9.39 7.36 9.22 7.42 9.06 7.42Z"/>
          </svg>
          Share on WhatsApp
        </a>
        <a href="${item.eventLink || 'https://www.ambitn.org'}" target="_blank" rel="noopener noreferrer" class="modal-cta-btn">
          Visit Event Page &nearr;
        </a>
      `;

      modal.classList.add('open');
    }

    function closeWixModal() {
      const modal = document.getElementById('wixModalBackdrop');
      if (modal) modal.classList.remove('open');
    }

    function openWixInstructions() {
      const modal = document.getElementById('wixModalBackdrop');
      document.getElementById('wixModalTitle').textContent = 'Instructions to Participants';
      document.getElementById('wixModalBody').innerHTML = `
        <ul style="padding-left: 20px; line-height: 1.8; color: #cbd5e1;">
          <li>All delegates are requested to complete online registration prior to the event dates.</li>
          <li>Accredited certificates with TN Medical Council (TNMC) credit hours will be issued upon completion.</li>
          <li>For workshops featuring hands-on chromatography (LCMS, HPLC) and molecular diagnostics, lab coats are recommended.</li>
          <li>Use the <strong>Share on WhatsApp</strong> button to inform departmental colleagues and postgraduate scholars.</li>
        </ul>
      `;
      document.getElementById('wixModalActions').innerHTML = `
        <button onclick="closeWixModal()" class="modal-cta-btn" style="background: var(--accent-gold); color: #000;">
          Close
        </button>
      `;
      modal.classList.add('open');
    }

    // Live search filter across the 20 events
    function wixFilterDark() {
      const q = document.getElementById('wixDarkSearch').value.toLowerCase().trim();
      if (!q) {
        currentEventsDisplayList = [...ambiTNMasterEvents];
      } else {
        currentEventsDisplayList = ambiTNMasterEvents.filter(ev => {
          const text = [
            ev.eventName,
            ev.venue,
            ev.organizer,
            ev.eventDate,
            ...(ev.tags || [])
          ].join(' ').toLowerCase();
          return text.indexOf(q) > -1;
        });
      }
      renderAmbiEvents(currentEventsDisplayList);
    }

    // Try merging live events from API if any new ones were added in CMS
    async function syncWithWixAPI() {
      try {
        const res = await fetch('https://www.ambitn.org/_functions/events', {
          headers: { 'Accept': 'application/json' }
        });
        if (res.ok) {
          const cmsData = await res.json();
          if (Array.isArray(cmsData) && cmsData.length > 0) {
            const validCms = cmsData.filter(d => d && (d.eventName || d.title));
            if (validCms.length > 0) {
              // Add fresh CMS items to top of list
              validCms.forEach(c => {
                const exists = ambiTNMasterEvents.some(m => m.eventName.toLowerCase() === (c.eventName || '').toLowerCase());
                if (!exists) {
                  ambiTNMasterEvents.unshift({
                    id: c.id || ('cms-' + Math.random()),
                    eventName: c.eventName || c.title,
                    eventDate: c.eventDate || c.date || 'Upcoming',
                    venue: c.venue || 'Tamil Nadu',
                    organizer: 'AMBI TN Chapter',
                    tags: ['CME', 'WORKSHOP'],
                    workshopNote: 'Registered event on',
                    eventLink: c.eventLink || 'https://www.ambitn.org'
                  });
                }
              });
              currentEventsDisplayList = [...ambiTNMasterEvents];
              renderAmbiEvents(currentEventsDisplayList);
            }
          }
        }
      } catch (err) {
        // Fallback silently remains on the 20 master events
      }
    }

    // Initial render & sync
    renderAmbiEvents(currentEventsDisplayList);
    syncWithWixAPI();

    // Close modal on background click
    document.getElementById('wixModalBackdrop').addEventListener('click', function(e) {
      if (e.target === this) {
        closeWixModal();
      }
    });
  </script>
</div>

</body></html>
