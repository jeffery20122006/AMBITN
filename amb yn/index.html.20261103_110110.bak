<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Academic Events | AMBI TN (Dark Glass)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      padding: 24px 16px;
      background: #070d18;
      min-height: 100vh;
      font-family: 'Outfit', sans-serif;
    }
  </style>
</head>
<body>
  <!-- Embedded Section Component -->
<!-- 
  AMBI TN - Academic Events Section (Dark Glassy Theme - 20 Detailed Events with WhatsApp Sharing)
  Paste this entire code block into Wix Studio / Wix Editor's "Embed HTML" element.
-->
<div id="ambitn-darkglass-root">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

  <style>
    #ambitn-darkglass-root {
      --bg-dark: #070d18;
      --glass-surface: rgba(14, 24, 44, 0.75);
      --glass-border: rgba(255, 255, 255, 0.1);
      --glass-border-gold: rgba(245, 158, 11, 0.4);
      --accent-gold: #f59e0b;
      --accent-cyan: #38bdf8;
      --accent-whatsapp: #25d366;
      --text-white: #ffffff;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;

      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #080f1e;
      background-image: radial-gradient(circle at 10% 20%, rgba(30, 58, 138, 0.4) 0%, transparent 40%),
                        radial-gradient(circle at 90% 15%, rgba(245, 158, 11, 0.15) 0%, transparent 35%),
                        radial-gradient(circle at 50% 90%, rgba(14, 165, 233, 0.18) 0%, transparent 45%),
                        #080f1e;
      color: var(--text-white);
      border-radius: 24px;
      border: 1px solid var(--glass-border);
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1);
      overflow: hidden;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      line-height: 1.5;
      position: relative;
    }

    #ambitn-darkglass-root * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    /* Top Hero Header Section */
    #ambitn-darkglass-root .hero-top-section {
      position: relative;
      padding: 36px 42px 28px 42px;
      background: linear-gradient(180deg, rgba(18, 32, 60, 0.55) 0%, rgba(10, 18, 34, 0.75) 100%);
      border-bottom: 1px solid var(--glass-border);
      overflow: hidden;
    }

    #ambitn-darkglass-root .hero-bg-visual {
      position: absolute;
      right: 0;
      top: 0;
      bottom: 0;
      width: 52%;
      background-image: url('https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1200&q=80');
      background-size: cover;
      background-position: center right;
      mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.2) 25%, rgba(0,0,0,0.85) 75%);
      -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.2) 25%, rgba(0,0,0,0.85) 75%);
      opacity: 0.35;
      pointer-events: none;
      mix-blend-mode: luminosity;
    }

    #ambitn-darkglass-root .brand-header-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 24px;
      position: relative;
      z-index: 2;
    }

    #ambitn-darkglass-root .brand-logo-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, rgba(15, 30, 56, 0.9) 0%, rgba(26, 48, 88, 0.9) 100%);
      border: 1px solid rgba(245, 158, 11, 0.4);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-gold);
      box-shadow: 0 0 20px rgba(245, 158, 11, 0.25);
    }

    #ambitn-darkglass-root .brand-title {
      font-size: 22px;
      font-weight: 800;
      color: var(--text-white);
      letter-spacing: 0.5px;
    }

    #ambitn-darkglass-root .brand-tagline {
      font-size: 11.5px;
      font-weight: 500;
      color: var(--text-muted);
      margin-top: 2px;
    }

    #ambitn-darkglass-root .hero-content-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 32px;
      position: relative;
      z-index: 2;
      align-items: center;
    }

    #ambitn-darkglass-root .title-line-wrap {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 6px;
    }

    #ambitn-darkglass-root .cal-icon-box {
      width: 40px;
      height: 40px;
      color: var(--accent-gold);
      display: flex;
      align-items: center;
      justify-content: center;
      filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.4));
    }

    #ambitn-darkglass-root .cal-icon-box svg {
      width: 34px;
      height: 34px;
    }

    #ambitn-darkglass-root .gold-vertical-divider {
      width: 4px;
      height: 36px;
      background: linear-gradient(to bottom, #fbbf24, #d97706);
      border-radius: 3px;
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    }

    #ambitn-darkglass-root .hero-main-heading {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 36px;
      font-weight: 700;
      color: var(--text-white);
      letter-spacing: -0.5px;
    }

    #ambitn-darkglass-root .hero-sub-title {
      font-size: 16px;
      font-weight: 600;
      color: var(--accent-cyan);
      font-style: italic;
      margin-bottom: 12px;
      margin-left: 54px;
    }

    #ambitn-darkglass-root .hero-gold-separator {
      width: 65px;
      height: 3px;
      background: linear-gradient(90deg, #f59e0b, transparent);
      border-radius: 2px;
      margin-bottom: 16px;
      margin-left: 54px;
    }

    #ambitn-darkglass-root .hero-body-paragraphs {
      margin-left: 54px;
      font-size: 13.5px;
      color: var(--text-secondary);
      line-height: 1.65;
    }

    #ambitn-darkglass-root .hero-body-paragraphs p {
      margin-bottom: 10px;
    }

    #ambitn-darkglass-root .hero-body-paragraphs strong {
      color: #ffffff;
      font-weight: 700;
    }

    /* Dark Glass Awards Card */
    #ambitn-darkglass-root .awards-glass-card {
      background: rgba(18, 30, 54, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border-gold);
      border-radius: 20px;
      padding: 22px 26px;
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 0 20px rgba(245, 158, 11, 0.1);
      display: flex;
      align-items: center;
      gap: 20px;
      max-width: 480px;
      margin-left: auto;
    }

    #ambitn-darkglass-root .trophy-badge-wrap {
      width: 80px;
      height: 80px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, transparent 70%);
      filter: drop-shadow(0 0 12px rgba(245, 158, 11, 0.4));
    }

    #ambitn-darkglass-root .awards-details-wrap {
      flex: 1;
    }

    #ambitn-darkglass-root .awards-card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
    }

    #ambitn-darkglass-root .awards-card-header h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 19px;
      font-weight: 700;
      color: var(--accent-gold);
    }

    #ambitn-darkglass-root .award-pill-item {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(245, 158, 11, 0.25);
      border-radius: 50px;
      padding: 8px 16px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
      font-weight: 700;
      color: #ffffff;
    }

    #ambitn-darkglass-root .award-star-icon {
      color: var(--accent-gold);
    }

    /* Wave graphic transition */
    #ambitn-darkglass-root .decorative-wave-bar {
      width: 100%;
      height: 40px;
      position: relative;
      overflow: hidden;
      background: rgba(10, 18, 34, 0.95);
    }

    #ambitn-darkglass-root .wave-svg {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    /* Table Section */
    #ambitn-darkglass-root .events-table-section {
      padding: 26px 42px 42px 42px;
    }

    #ambitn-darkglass-root .table-controls-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 22px;
      flex-wrap: wrap;
      gap: 16px;
    }

    #ambitn-darkglass-root .section-title-box {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    #ambitn-darkglass-root .section-gold-stripe {
      width: 4px;
      height: 26px;
      background: linear-gradient(to bottom, #fbbf24, #d97706);
      border-radius: 4px;
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
    }

    #ambitn-darkglass-root .section-title-box h2 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 25px;
      font-weight: 700;
      color: var(--text-white);
    }

    #ambitn-darkglass-root .actions-right-wrap {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    #ambitn-darkglass-root .search-input-pill-wrap {
      position: relative;
      width: 270px;
    }

    #ambitn-darkglass-root .search-input-pill-wrap svg {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 15px;
      height: 15px;
      color: var(--text-muted);
    }

    #ambitn-darkglass-root .search-input-pill {
      width: 100%;
      padding: 8px 14px 8px 36px;
      background: rgba(18, 30, 54, 0.7);
      border: 1px solid var(--glass-border);
      border-radius: 50px;
      font-size: 13px;
      color: var(--text-white);
      outline: none;
    }

    #ambitn-darkglass-root .search-input-pill:focus {
      border-color: var(--accent-cyan);
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.25);
    }

    #ambitn-darkglass-root .instructions-link-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
      color: var(--accent-cyan);
      text-decoration: none;
      cursor: pointer;
      padding: 8px 14px;
      border-radius: 50px;
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.25);
      transition: all 0.2s ease;
    }

    #ambitn-darkglass-root .instructions-link-btn:hover {
      background: rgba(56, 189, 248, 0.2);
      border-color: var(--accent-cyan);
      color: #ffffff;
    }

    /* Structured Dark Glass Table */
    #ambitn-darkglass-root .table-container-card {
      background: rgba(13, 23, 42, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--glass-border);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    #ambitn-darkglass-root .events-structured-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    #ambitn-darkglass-root .events-structured-table thead tr {
      background: rgba(22, 36, 65, 0.85);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    #ambitn-darkglass-root .events-structured-table th {
      padding: 16px 18px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: var(--accent-gold);
      border-right: 1px solid rgba(255, 255, 255, 0.08);
    }

    #ambitn-darkglass-root .events-structured-table th:last-child {
      border-right: none;
    }

    #ambitn-darkglass-root .th-sno { width: 65px; text-align: center; }
    #ambitn-darkglass-root .th-name { width: 48%; }
    #ambitn-darkglass-root .th-date { width: 23%; }
    #ambitn-darkglass-root .th-venue { width: 25%; }

    #ambitn-darkglass-root .events-structured-table tbody tr {
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      transition: background-color 0.2s ease;
    }

    #ambitn-darkglass-root .events-structured-table tbody tr:nth-child(even) {
      background-color: rgba(18, 30, 54, 0.35);
    }

    #ambitn-darkglass-root .events-structured-table tbody tr:hover {
      background-color: rgba(30, 48, 86, 0.5);
    }

    #ambitn-darkglass-root .events-structured-table td {
      padding: 16px 18px;
      font-size: 13.5px;
      color: var(--text-secondary);
      vertical-align: middle;
      border-right: 1px solid rgba(255, 255, 255, 0.06);
    }

    #ambitn-darkglass-root .events-structured-table td:last-child {
      border-right: none;
    }

    #ambitn-darkglass-root .td-sno-col {
      text-align: center;
      font-weight: 800;
      color: var(--accent-gold);
      font-size: 15px;
    }

    #ambitn-darkglass-root .event-entry-title {
      font-size: 14.5px;
      font-weight: 700;
      color: #60a5fa;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      line-height: 1.45;
      text-decoration: none;
      transition: color 0.2s ease, text-shadow 0.2s ease;
    }

    #ambitn-darkglass-root .event-entry-title:hover {
      color: var(--accent-cyan);
      text-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
    }

    /* Tags Row */
    #ambitn-darkglass-root .event-workshops-tagline {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
      font-size: 12px;
      color: var(--text-muted);
    }

    #ambitn-darkglass-root .badge-highlight {
      background: rgba(14, 165, 233, 0.15);
      border: 1px solid rgba(14, 165, 233, 0.35);
      color: var(--accent-cyan);
      padding: 2px 7px;
      border-radius: 4px;
      font-weight: 700;
      font-size: 11px;
      letter-spacing: 0.3px;
    }

    /* WhatsApp Share Button */
    #ambitn-darkglass-root .whatsapp-share-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 9px;
      border-radius: 50px;
      background: rgba(37, 211, 102, 0.14);
      border: 1px solid rgba(37, 211, 102, 0.45);
      color: #4ade80;
      font-size: 11px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
      cursor: pointer;
      margin-left: 4px;
    }

    #ambitn-darkglass-root .whatsapp-share-btn:hover {
      background: rgba(37, 211, 102, 0.3);
      border-color: #25d366;
      color: #ffffff;
      box-shadow: 0 0 10px rgba(37, 211, 102, 0.4);
      transform: translateY(-1px);
    }

    #ambitn-darkglass-root .whatsapp-share-btn svg {
      width: 13px;
      height: 13px;
      fill: currentColor;
    }

    #ambitn-darkglass-root .date-cell-wrap {
      display: flex;
      align-items: center;
      gap: 9px;
      font-weight: 600;
      color: #ffffff;
      font-size: 13.5px;
    }

    #ambitn-darkglass-root .date-cell-wrap svg {
      width: 17px;
      height: 17px;
      color: var(--accent-cyan);
      flex-shrink: 0;
      filter: drop-shadow(0 0 6px var(--accent-cyan));
    }

    #ambitn-darkglass-root .venue-cell-wrap {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      color: var(--text-secondary);
    }

    #ambitn-darkglass-root .venue-cell-wrap svg {
      width: 17px;
      height: 17px;
      color: var(--accent-gold);
      flex-shrink: 0;
      margin-top: 2px;
      filter: drop-shadow(0 0 6px var(--accent-gold));
    }

    #ambitn-darkglass-root .venue-name {
      font-weight: 600;
      color: #ffffff;
      line-height: 1.35;
    }

    #ambitn-darkglass-root .venue-sub {
      font-size: 12px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    /* Modal inside Embed */
    #ambitn-darkglass-root .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(3, 7, 18, 0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 99999;
      padding: 20px;
    }

    #ambitn-darkglass-root .modal-backdrop.open {
      display: flex;
    }

    #ambitn-darkglass-root .modal-sheet {
      background: rgba(15, 26, 48, 0.96);
      border: 1px solid var(--glass-border-gold);
      border-radius: 20px;
      width: 100%;
      max-width: 540px;
      padding: 28px;
      position: relative;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 30px rgba(245, 158, 11, 0.15);
      color: #ffffff;
      animation: ambitnModalFade 0.25s ease-out;
    }

    @keyframes ambitnModalFade {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }

    #ambitn-darkglass-root .modal-close-icon {
      position: absolute;
      top: 18px;
      right: 18px;
      background: rgba(255, 255, 255, 0.1);
      border: none;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      cursor: pointer;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    #ambitn-darkglass-root .modal-sheet h3 {
      font-family: 'Playfair Display', Georgia, serif;
      font-size: 21px;
      color: var(--accent-gold);
      margin-bottom: 14px;
      line-height: 1.35;
    }

    #ambitn-darkglass-root .modal-info-row {
      margin-bottom: 12px;
      font-size: 14px;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    #ambitn-darkglass-root .modal-info-row strong {
      color: #ffffff;
    }

    #ambitn-darkglass-root .modal-actions-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 20px;
      flex-wrap: wrap;
    }

    #ambitn-darkglass-root .modal-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #070d18;
      font-weight: 700;
      font-size: 13.5px;
      border-radius: 8px;
      text-decoration: none;
      box-shadow: 0 4px 15px rgba(245, 158, 11, 0.3);
      cursor: pointer;
      border: none;
    }

    #ambitn-darkglass-root .modal-whatsapp-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: #25d366;
      color: #070d18;
      font-weight: 700;
      font-size: 13.5px;
      border-radius: 8px;
      text-decoration: none;
      box-shadow: 0 4px 15px rgba(37, 211, 102, 0.35);
      cursor: pointer;
      border: none;
    }

    #ambitn-darkglass-root .modal-whatsapp-btn svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }

    /* ========================================================
       📱 MOBILE OPTIMIZATION (≤ 768px)
       ======================================================== */
    @media (max-width: 992px) {
      #ambitn-darkglass-root .hero-content-grid {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      #ambitn-darkglass-root .awards-glass-card {
        margin: 10px 0 0 0;
        max-width: 100%;
      }
      #ambitn-darkglass-root .hero-body-paragraphs,
      #ambitn-darkglass-root .hero-sub-title,
      #ambitn-darkglass-root .hero-gold-separator {
        margin-left: 0;
      }
    }

    @media (max-width: 768px) {
      #ambitn-darkglass-root .hero-top-section {
        padding: 22px 16px;
      }

      #ambitn-darkglass-root .hero-main-heading {
        font-size: 27px;
      }

      #ambitn-darkglass-root .hero-sub-title {
        font-size: 14px;
        margin-left: 0;
      }

      #ambitn-darkglass-root .hero-gold-separator {
        margin-left: 0;
      }

      #ambitn-darkglass-root .hero-body-paragraphs {
        margin-left: 0;
        font-size: 13px;
      }

      #ambitn-darkglass-root .awards-glass-card {
        flex-direction: column;
        text-align: center;
        padding: 18px 14px;
        gap: 14px;
      }

      #ambitn-darkglass-root .awards-card-header {
        justify-content: center;
      }

      #ambitn-darkglass-root .events-table-section {
        padding: 18px 14px;
      }

      #ambitn-darkglass-root .table-controls-row {
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
      }

      #ambitn-darkglass-root .actions-right-wrap {
        flex-direction: column;
        width: 100%;
        gap: 10px;
      }

      #ambitn-darkglass-root .search-input-pill-wrap {
        width: 100%;
      }

      #ambitn-darkglass-root .instructions-link-btn {
        width: 100%;
        justify-content: center;
      }

      /* 📱 Transform Table into Dark Glass Mobile Cards */
      #ambitn-darkglass-root .events-structured-table, 
      #ambitn-darkglass-root .events-structured-table thead, 
      #ambitn-darkglass-root .events-structured-table tbody, 
      #ambitn-darkglass-root .events-structured-table th, 
      #ambitn-darkglass-root .events-structured-table td, 
      #ambitn-darkglass-root .events-structured-table tr {
        display: block;
      }

      #ambitn-darkglass-root .events-structured-table thead {
        display: none;
      }

      #ambitn-darkglass-root .table-container-card {
        background: transparent;
        border: none;
        box-shadow: none;
      }

      #ambitn-darkglass-root .events-structured-table tbody tr {
        background: rgba(18, 30, 54, 0.75) !important;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        margin-bottom: 14px;
        padding: 16px 14px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
      }

      #ambitn-darkglass-root .events-structured-table td {
        padding: 6px 0;
        border: none;
      }

      #ambitn-darkglass-root .td-sno-col {
        display: inline-block !important;
        background: rgba(245, 158, 11, 0.15);
        border: 1px solid var(--accent-gold);
        color: var(--accent-gold);
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 11px;
        margin-bottom: 6px;
        text-align: left;
      }

      #ambitn-darkglass-root .td-sno-col::before {
        content: "EVENT #";
        font-size: 10px;
        margin-right: 4px;
      }

      #ambitn-darkglass-root .date-cell-wrap {
        margin-top: 6px;
        padding-top: 8px;
        border-top: 1px dashed rgba(255, 255, 255, 0.1);
      }

      #ambitn-darkglass-root .venue-cell-wrap {
        margin-top: 6px;
      }
    }
  </style>

  <!-- Hero Banner -->
  <header class="hero-top-section">
